+using CUE4Parse.UE4.Assets.Exports.HairStrands;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Readers;
+using CUE4Parse.UE4.Versions;
+
+namespace CUE4Parse.Tests.UE4.Assets.Exports;
+
+public class GroomSerializationTests
+{
+    [Theory]
+    [InlineData(EGame.GAME_UE5_5, 8)]
+    [InlineData(EGame.GAME_UE5_6, 12)]
+    [InlineData(EGame.GAME_UE5_7, 12)]
+    public void BindingPlatformDataReadsVersionedMinimumLod(EGame game, int expectedSize)
+    {
+        // Empty simulation roots, empty cards roots, and UE 5.6+ TargetMeshMinLOD.
+        var data = new byte[expectedSize];
+        if (expectedSize == 12)
+            BitConverter.GetBytes(7).CopyTo(data, 8);
+        using var baseArchive = new FByteArchive("synthetic-groom-platform-data", data, new VersionContainer(game));
+        var archive = new FAssetArchive(baseArchive, null);
+
+        var platformData = new UGroomBindingAsset.FHairGroupPlatformData(archive, EGroomClassStripFlags.CDSF_StrandsStripped);
+
+        Assert.Equal(expectedSize, archive.Position);
+        Assert.Equal(game >= EGame.GAME_UE5_6 ? 7 : -1, platformData.TargetMeshMinLOD);
+    }
+
+    [Theory]
+    [InlineData(EGame.GAME_UE5_5, 65, 0, false)]
+    [InlineData(EGame.GAME_UE5_6, 73, 0, true)]
+    [InlineData(EGame.GAME_UE5_7, 77, 2, true)]
+    public void GroomMeshBulkDataReadsVersionedHeader(EGame game, int expectedSize, uint expectedUvs, bool hasVertexColors)
+    {
+        // Four empty arrays before UE 5.6 and five after it, the 49-byte LWC FBox, then UE 5.7 NumUVs and the vertex-color flag.
+        var data = new byte[expectedSize];
+        if (game >= EGame.GAME_UE5_7)
+            BitConverter.GetBytes(expectedUvs).CopyTo(data, 69);
+        if (game >= EGame.GAME_UE5_6)
+            BitConverter.GetBytes(1).CopyTo(data, expectedSize - 4);
+        using var baseArchive = new FByteArchive("synthetic-groom-mesh", data, new VersionContainer(game));
+        var archive = new FAssetArchive(baseArchive, null);
+
+        var mesh = new UGroomAsset.FHairGroupPlatformData.FHairMeshesBulkData(archive);
+
+        Assert.Equal(expectedSize, archive.Position);
+        Assert.Equal(expectedUvs, mesh.Header.NumUVs);
+        Assert.Equal(hasVertexColors, mesh.Header.bVertexColor);
+        Assert.Empty(mesh.VertexColors);
+    }
+
+}
