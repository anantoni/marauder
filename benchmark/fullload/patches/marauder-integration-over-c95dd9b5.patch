+using CUE4Parse.MappingsProvider;
+using CUE4Parse.UE4.Assets;
+using CUE4Parse.UE4.Assets.Exports;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Objects.Chaos;
+using CUE4Parse.UE4.Objects.Chaos.Union;
+using CUE4Parse.UE4.Objects.UObject;
+using CUE4Parse.UE4.Readers;
+using CUE4Parse.UE4.Versions;
+
+namespace CUE4Parse.Tests;
+
+public class ImplicitObjectUnionTests
+{
+    // UE 5.2 union layout: implicit object header, no children, float AABB, then the bHierarchyBuilt flag
+    private static byte[] Union52(bool hierarchyBuilt)
+    {
+        using var s = new MemoryStream();
+        s.Write(BitConverter.GetBytes(0));  // bIsConvex
+        s.Write(BitConverter.GetBytes(1));  // bDoCollide
+        s.WriteByte(0);                     // CollisionType
+        s.Write(BitConverter.GetBytes(0));  // MObjects count
+        for (var i = 0; i < 6; i++) s.Write(BitConverter.GetBytes((float) i)); // MLocalBoundingBox
+        s.Write(BitConverter.GetBytes(hierarchyBuilt ? 1 : 0));
+        return s.ToArray();
+    }
+
+    private static FChaosArchive Archive(byte[] bytes) =>
+        new(new FAssetArchive(new FByteArchive("synthetic", bytes, new VersionContainer(EGame.GAME_UE5_2)), new SyntheticPackage()));
+
+    [Fact]
+    public void ReadsUnionWithoutHierarchy()
+    {
+        var bytes = Union52(false);
+        var ar = Archive(bytes);
+        var union = new FImplicitObjectUnion();
+        union.Serialize(ar);
+
+        Assert.Equal(bytes.Length, ar.Position);
+        Assert.Empty(union.MObjects!);
+    }
+
+    [Fact]
+    public void LegacyHierarchyPayloadIsStillUnsupported()
+    {
+        Assert.Throws<NotImplementedException>(() => new FImplicitObjectUnion().Serialize(Archive(Union52(true))));
+    }
+
+    private sealed class SyntheticPackage : IPackage
+    {
+        public string Name { get; set; } = "synthetic";
+        public CUE4Parse.FileProvider.IFileProvider? Provider => null;
+        public string? ArchiveName => null;
+        public TypeMappings? Mappings => null;
+        public FPackageFileSummary Summary => default;
+        public FNameEntrySerialized[] NameMap { get; } = [new FNameEntrySerialized("None")];
+        public int ImportMapLength => 0;
+        public int ExportMapLength => 0;
+        public Lazy<UObject>[] ExportsLazy => [];
+        public bool IsFullyLoaded => true;
+        public bool CanDeserialize => true;
+        public bool HasFlags(EPackageFlags flags) => false;
+        public int GetExportIndex(string name, StringComparison comparisonType = StringComparison.Ordinal) => -1;
+        public ResolvedObject? ResolvePackageIndex(FPackageIndex? index) => null;
+    }
+}
