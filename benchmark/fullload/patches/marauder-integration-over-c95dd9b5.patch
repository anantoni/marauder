+using CUE4Parse.MappingsProvider;
+using CUE4Parse.UE4.Assets;
+using CUE4Parse.UE4.Assets.Exports;
+using CUE4Parse.UE4.Assets.Exports.Datasmith;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Objects.UObject;
+using CUE4Parse.UE4.Readers;
+using CUE4Parse.UE4.Versions;
+
+namespace CUE4Parse.Tests;
+
+public class DatasmithSceneTests
+{
+    [Theory]
+    [InlineData(EGame.GAME_UE4_27)]
+    [InlineData(EGame.GAME_UE5_2)]
+    [InlineData(EGame.GAME_UE5_3)]
+    public void ReadsStripFlagsAfterProperties(EGame game)
+    {
+        using var s = new MemoryStream();
+        s.Write(BitConverter.GetBytes(0L)); // tagged properties: None
+        if (new FByteArchive("v", [], new VersionContainer(game)).Ver >= EUnrealEngineObjectUE5Version.PROPERTY_TAG_EXTENSION_AND_OVERRIDABLE_SERIALIZATION)
+            s.WriteByte(0); // class serialization control extension
+        s.Write(BitConverter.GetBytes(0));  // no object guid
+        s.Write([1, 0]);                    // strip flags: editor data stripped
+        var bytes = s.ToArray();
+
+        var archive = new FAssetArchive(new FByteArchive("synthetic", bytes, new VersionContainer(game)), new SyntheticPackage());
+        var scene = new UDatasmithScene();
+        scene.Deserialize(archive, bytes.Length);
+
+        Assert.Equal(bytes.Length, archive.Position);
+        Assert.True(scene.StripFlags.IsEditorDataStripped());
+    }
+
+    private sealed class SyntheticPackage : IPackage
+    {
+        public string Name { get; set; } = "synthetic";
+        public CUE4Parse.FileProvider.IFileProvider? Provider => null;
+        public string? ArchiveName => null;
+        public TypeMappings? Mappings => null;
+        public FPackageFileSummary Summary => default;
+        public FNameEntrySerialized[] NameMap { get; } = [new FNameEntrySerialized("None")];
+        public int ImportMapLength => 0;
+        public int ExportMapLength => 0;
+        public Lazy<UObject>[] ExportsLazy => [];
+        public bool IsFullyLoaded => true;
+        public bool CanDeserialize => true;
+        public bool HasFlags(EPackageFlags flags) => false;
+        public int GetExportIndex(string name, StringComparison comparisonType = StringComparison.Ordinal) => -1;
+        public ResolvedObject? ResolvePackageIndex(FPackageIndex? index) => null;
+    }
+}
