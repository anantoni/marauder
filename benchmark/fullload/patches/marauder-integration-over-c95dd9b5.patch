diff --git a/CUE4Parse/UE4/Assets/Objects/TaggedContainerTypes.cs b/CUE4Parse/UE4/Assets/Objects/TaggedContainerTypes.cs
new file mode 100644
index 00000000..9ea1e84a
--- /dev/null
+++ b/CUE4Parse/UE4/Assets/Objects/TaggedContainerTypes.cs
@@ -0,0 +1,133 @@
+using CUE4Parse.MappingsProvider;
+using CUE4Parse.UE4.Objects.UObject;
+
+namespace CUE4Parse.UE4.Assets.Objects;
+
+/// <summary>
+/// Tagged (pre PROPERTY_TAG_COMPLETE_TYPE_NAME) set and map tags name only the inner property types, not the struct
+/// or enum behind a StructProperty or ByteProperty key, element or value. Unreal takes them from the owning
+/// property definition; this looks that definition up in the owner struct (serialized FProperty or legacy
+/// UProperty children, or the mappings for script classes) and fills in the missing tag data.
+/// </summary>
+internal static class TaggedContainerTypes
+{
+    private static bool Missing(string? type, FPropertyTagData? data) => type switch
+    {
+        "StructProperty" => data?.StructType is null,
+        "ByteProperty" => data?.EnumName is null,
+        _ => false
+    };
+
+    public static bool NeedsResolve(FPropertyTagData? tagData) => tagData?.Type switch
+    {
+        "SetProperty" => Missing(tagData.InnerType, tagData.InnerTypeData),
+        "MapProperty" => Missing(tagData.InnerType, tagData.InnerTypeData) || Missing(tagData.ValueType, tagData.ValueTypeData),
+        _ => false
+    };
+
+    public static void Resolve(FPropertyTagData tagData, string propertyName, UStruct? owner, TypeMappings? mappings)
+    {
+        if (owner is null || !TryFind(owner, propertyName, mappings, out var key, out var value)) return;
+
+        if (Missing(tagData.InnerType, tagData.InnerTypeData) && key is not null)
+            tagData.InnerTypeData = Fill(tagData.InnerType!, tagData.InnerTypeData, key.Value);
+        if (tagData.Type == "MapProperty" && Missing(tagData.ValueType, tagData.ValueTypeData) && value is not null)
+            tagData.ValueTypeData = Fill(tagData.ValueType!, tagData.ValueTypeData, value.Value);
+    }
+
+    private static FPropertyTagData? Fill(string type, FPropertyTagData? data, (string Type, string? Name) found)
+    {
+        if (found.Name is null || found.Type != type) return data;
+        data ??= new FPropertyTagData { Type = type };
+        if (type == "StructProperty") data.StructType = found.Name;
+        else data.EnumName = found.Name;
+        return data;
+    }
+
+    private static bool TryFind(UStruct owner, string name, TypeMappings? mappings, out (string Type, string? Name)? key, out (string Type, string? Name)? value)
+    {
+        key = value = null;
+        UStruct? struc = owner;
+        for (var depth = 0; struc is not null && depth < 64; depth++)
+        {
+            if (struc is UScriptClass)
+                return mappings is not null && mappings.Types.TryGetValue(struc.Name, out var mapped) && TryFindMapped(mapped, name, out key, out value);
+
+            if (struc.ChildProperties is { Length: > 0 } fields)
+            {
+                foreach (var field in fields)
+                {
+                    if (field is not FProperty prop || !prop.Name.Text.Equals(name, StringComparison.OrdinalIgnoreCase)) continue;
+                    (key, value) = prop switch
+                    {
+                        FMapProperty map => (Describe(map.KeyProp), Describe(map.ValueProp)),
+                        FSetProperty set => (Describe(set.ElementProp), null),
+                        _ => (null, null)
+                    };
+                    return true;
+                }
+            }
+
+            if (struc.Children is { Length: > 0 } children)
+            {
+                foreach (var child in children)
+                {
+                    if (!child.TryLoad<UProperty>(out var prop) || !prop.Name.Equals(name, StringComparison.OrdinalIgnoreCase)) continue;
+                    (key, value) = prop switch
+                    {
+                        UMapProperty map => (Describe(map.KeyProp), Describe(map.ValueProp)),
+                        USetProperty set => (Describe(set.ElementProp), null),
+                        _ => (null, null)
+                    };
+                    return true;
+                }
+            }
+
+            struc = struc.SuperStruct?.TryLoad<UStruct>(out var super) == true ? super : null;
+        }
+        return false;
+    }
+
+    private static bool TryFindMapped(Struct? mapped, string name, out (string Type, string? Name)? key, out (string Type, string? Name)? value)
+    {
+        key = value = null;
+        for (var depth = 0; mapped is not null && depth < 64; depth++)
+        {
+            foreach (var info in mapped.Properties.Values)
+            {
+                if (!info.Name.Equals(name, StringComparison.OrdinalIgnoreCase)) continue;
+                key = Describe(info.MappingType.InnerType);
+                value = info.MappingType.Type == "MapProperty" ? Describe(info.MappingType.ValueType) : null;
+                return true;
+            }
+            mapped = mapped.Super.Value;
+        }
+        return false;
+    }
+
+    private static (string, string?)? Describe(PropertyType? type) => type switch
+    {
+        null => null,
+        { Type: "StructProperty" } => ("StructProperty", type.StructType),
+        { Type: "ByteProperty" or "EnumProperty" } => ("ByteProperty", type.EnumName),
+        _ => null
+    };
+
+    private static (string, string?)? Describe(FProperty? prop) => prop switch
+    {
+        FStructProperty s => ("StructProperty", s.Struct.ResolvedObject?.Name.Text),
+        FByteProperty b => ("ByteProperty", b.Enum.ResolvedObject?.Name.Text),
+        _ => null
+    };
+
+    private static (string, string?)? Describe(FPackageIndex? index)
+    {
+        if (index is null || !index.TryLoad<UProperty>(out var prop)) return null;
+        return prop switch
+        {
+            UStructProperty s => ("StructProperty", s.Struct.ResolvedObject?.Name.Text),
+            UByteProperty b => ("ByteProperty", b.Enum.ResolvedObject?.Name.Text),
+            _ => null
+        };
+    }
+}
