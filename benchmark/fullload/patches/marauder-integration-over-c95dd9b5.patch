                 Properties.Add(property);
             else
                 Log.Debug("Failed to read element for index {Index} in set", i);
         }
     }
+
+    // Elements to remove and elements both precede their counts; the tag size fits the FName layout (8 bytes per element) or the byte layout, not both.
+    private static bool HasFNameElements(FAssetArchive Ar, int size)
+    {
+        var start = Ar.Position;
+        try
+        {
+            var numToRemove = Ar.Read<int>();
+            if (numToRemove < 0 || 8L * numToRemove + 8 > size) return false;
+            Ar.Position += 8L * numToRemove;
+            var num = Ar.Read<int>();
+            return num >= 0 && numToRemove + num > 0 && 8 + 8L * (numToRemove + num) == size;
+        }
+        finally
+        {
+            Ar.Position = start;
+        }
+    }
 }
