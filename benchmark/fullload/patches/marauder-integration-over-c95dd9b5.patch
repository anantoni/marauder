diff --git a/CUE4Parse.Tests/SerializedEnumPropertyTests.cs b/CUE4Parse.Tests/SerializedEnumPropertyTests.cs
new file mode 100644
index 00000000..11a86a27
--- /dev/null
+++ b/CUE4Parse.Tests/SerializedEnumPropertyTests.cs
@@ -0,0 +1,70 @@
+using CUE4Parse.MappingsProvider;
+using CUE4Parse.UE4.Assets.Objects;
+using CUE4Parse.UE4.Assets.Objects.Properties;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Objects.UObject;
+using CUE4Parse.UE4.Readers;
+
+namespace CUE4Parse.Tests;
+
+// Mappings built from a package's own class (SerializedStruct) must read an FEnumProperty value
+// with the width of its UnderlyingProp, not always one byte.
+public class SerializedEnumPropertyTests
+{
+    private static FEnumProperty EnumProp(FNumericProperty? underlying, int elementSize) => new()
+    {
+        Name = new FName("Value"),
+        ElementSize = elementSize,
+        Enum = new FPackageIndex(),
+        UnderlyingProp = underlying,
+    };
+
+    // Reads one unversioned-style raw value; returns the read text and how many bytes were consumed
+    private static (string Value, long Read) ReadRaw(PropertyType type, byte[] bytes)
+    {
+        var Ar = new FAssetArchive(new FByteArchive("synthetic", bytes), null);
+        var tag = new FPropertyTag(Ar, new PropertyInfo(0, "Value", type), ReadType.RAW);
+        return (((EnumProperty) tag.Tag!).Value.Text, Ar.Position);
+    }
+
+    [Fact]
+    public void UInt16UnderlyingReadsTwoBytes()
+    {
+        var type = new PropertyType(EnumProp(new FUInt16Property { ElementSize = 2 }, 2));
+        Assert.Equal("UInt16Property", type.InnerType?.Type);
+
+        // 0x012C = 300, followed by a sentinel byte that must stay unread
+        var (value, read) = ReadRaw(type, [0x2C, 0x01, 0xAA]);
+        Assert.Equal("300", value);
+        Assert.Equal(2, read);
+    }
+
+    [Fact]
+    public void Int64UnderlyingReadsEightBytes()
+    {
+        var type = new PropertyType(EnumProp(new FInt64Property { ElementSize = 8 }, 8));
+        var (value, read) = ReadRaw(type, [0x05, 0, 0, 0, 0, 0, 0, 0, 0xAA]);
+        Assert.Equal("5", value);
+        Assert.Equal(8, read);
+    }
+
+    [Fact]
+    public void ByteUnderlyingStillReadsOneByte()
+    {
+        var type = new PropertyType(EnumProp(new FByteProperty { ElementSize = 1, Enum = new FPackageIndex() }, 1));
+        // the inner type is a plain number: no enum of its own, so the outer enum maps the index
+        Assert.Equal("ByteProperty", type.InnerType?.Type);
+        Assert.Null(type.InnerType?.EnumName);
+        Assert.Null(type.InnerType?.Enum);
+        var (value, read) = ReadRaw(type, [0x2F, 0xAA]);
+        Assert.Equal("47", value);
+        Assert.Equal(1, read);
+    }
+
+    [Fact]
+    public void MissingUnderlyingFallsBackToElementSize()
+    {
+        Assert.Null(new PropertyType(EnumProp(null, 1)).InnerType);
+        Assert.Equal("IntProperty", new PropertyType(EnumProp(null, 4)).InnerType?.Type);
+    }
+}
diff --git a/CUE4Parse.Tests/TaggedContainerPropertyTests.cs b/CUE4Parse.Tests/TaggedContainerPropertyTests.cs
new file mode 100644
index 00000000..21628695
--- /dev/null
+++ b/CUE4Parse.Tests/TaggedContainerPropertyTests.cs
@@ -0,0 +1,182 @@
+using CUE4Parse.MappingsProvider;
+using CUE4Parse.UE4.Assets;
+using CUE4Parse.UE4.Assets.Exports;
+using CUE4Parse.UE4.Assets.Objects;
+using CUE4Parse.UE4.Assets.Objects.Properties;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Objects.Core.Math;
+using CUE4Parse.UE4.Objects.Core.Misc;
+using CUE4Parse.UE4.Objects.MovieScene;
+using CUE4Parse.UE4.Objects.UObject;
+using CUE4Parse.UE4.Readers;
+using CUE4Parse.UE4.Versions;
+
+namespace CUE4Parse.Tests;
+
+// Synthetic tagged (versioned) property streams as a UE4 cooker writes them.
+public class TaggedContainerPropertyTests
+{
+    private static readonly string[] Names =
+    [
+        "None", "SetProperty", "ByteProperty", "AllowedTypes", "EType::First", "EType::Second",
+        "StructProperty", "Vector_NetQuantize", "Location", "FloatProperty", "X", "Y", "Z",
+        "MovieSceneFloatValue", "Value", "MapProperty", "SubSectionRanges", "ArrayProperty", "Values", "Scales", "OwnerClass"
+    ];
+
+    private sealed class Writer
+    {
+        private readonly MemoryStream _s = new();
+        public Writer Name(string n) { Int(Array.IndexOf(Names, n)); return Int(0); }
+        public Writer Int(int v) { _s.Write(BitConverter.GetBytes(v)); return this; }
+        public Writer Float(float v) { _s.Write(BitConverter.GetBytes(v)); return this; }
+        public Writer Byte(byte v) { _s.WriteByte(v); return this; }
+        public Writer Bytes(byte[] b) { _s.Write(b); return this; }
+        public Writer Guid() => Bytes(new byte[16]);
+        public int Length => (int) _s.Length;
+        public byte[] ToArray() => _s.ToArray();
+
+        // Name, Type, Size, ArrayIndex, type data, HasPropertyGuid
+        public Writer Tag(string name, string type, int size, Action<Writer> tagData)
+        {
+            Name(name).Name(type).Int(size).Int(0);
+            tagData(this);
+            return Byte(0);
+        }
+
+        public Writer Float(string name, float v) => Tag(name, "FloatProperty", 4, _ => { }).Float(v);
+    }
+
+    private static FAssetArchive Archive(byte[] bytes, EGame game, TypeMappings? mappings = null) =>
+        new(new FByteArchive("synthetic", bytes, new VersionContainer(game)), new SyntheticPackage { Mappings = mappings });
+
+    private static FPropertyTag ReadTag(byte[] bytes, EGame game, out FAssetArchive ar)
+    {
+        ar = Archive(bytes, game);
+        return new FPropertyTag(ar, true);
+    }
+
+    [Fact]
+    public void TaggedSetOfEnumBytesReadsNames()
+    {
+        var w = new Writer().Tag("AllowedTypes", "SetProperty", 24, t => t.Name("ByteProperty"))
+            .Int(0).Int(2).Name("EType::First").Name("EType::Second");
+        var tag = ReadTag(w.ToArray(), EGame.GAME_UE4_25, out var ar);
+
+        var set = Assert.IsType<SetProperty>(tag.Tag).Value;
+        Assert.Equal(["EType::First", "EType::Second"], set.Properties.Select(p => Assert.IsType<EnumProperty>(p).Value.Text));
+        Assert.Equal(w.Length, ar.Position);
+    }
+
+    [Fact]
+    public void TaggedSetOfEnumBytesWithElementsToRemoveReadsNames()
+    {
+        // A level instance overriding its archetype: one element removed, one added
+        var w = new Writer().Tag("AllowedTypes", "SetProperty", 24, t => t.Name("ByteProperty"))
+            .Int(1).Name("EType::First").Int(1).Name("EType::Second");
+        var tag = ReadTag(w.ToArray(), EGame.GAME_UE4_25, out _);
+
+        var set = Assert.IsType<SetProperty>(tag.Tag).Value;
+        Assert.Equal("EType::Second", Assert.IsType<EnumProperty>(Assert.Single(set.Properties)).Value.Text);
+    }
+
+    [Fact]
+    public void TaggedSetOfPlainBytesStillReadsBytes()
+    {
+        var w = new Writer().Tag("AllowedTypes", "SetProperty", 10, t => t.Name("ByteProperty"))
+            .Int(0).Int(2).Byte(3).Byte(7);
+        var tag = ReadTag(w.ToArray(), EGame.GAME_UE4_25, out _);
+
+        var set = Assert.IsType<SetProperty>(tag.Tag).Value;
+        Assert.Equal([3, 7], set.Properties.Select(p => (int) Assert.IsType<ByteProperty>(p).Value));
+    }
+
+    [Theory]
+    [InlineData(EGame.GAME_UE4_20)]
+    [InlineData(EGame.GAME_UE4_27)]
+    public void TaggedVectorNetQuantizeReadsTaggedComponents(EGame game)
+    {
+        var body = new Writer().Float("X", 1).Float("Y", 2).Float("Z", 3).Name("None");
+        var w = new Writer().Tag("Location", "StructProperty", body.Length, t => t.Name("Vector_NetQuantize").Guid()).Bytes(body.ToArray());
+        var tag = ReadTag(w.ToArray(), game, out _);
+
+        var fallback = Assert.IsType<FStructFallback>(Assert.IsType<StructProperty>(tag.Tag).Value.StructType);
+        Assert.Equal(3f, fallback.GetOrDefault<float>("Z"));
+    }
+
+    [Fact]
+    public void MovieSceneFloatValueBeforeSerializeFloatChannelIsTagged()
+    {
+        // UE 4.20: TArray<FMovieSceneFloatValue> with an inner struct tag, elements saved as tagged properties
+        var element = new Writer().Float("Value", 5).Name("None");
+        var innerTag = new Writer().Tag("Values", "StructProperty", element.Length, t => t.Name("MovieSceneFloatValue").Guid());
+        var size = 4 + innerTag.Length + element.Length;
+        var w = new Writer().Tag("Values", "ArrayProperty", size, t => t.Name("StructProperty"))
+            .Int(1).Bytes(innerTag.ToArray()).Bytes(element.ToArray());
+        var tag = ReadTag(w.ToArray(), EGame.GAME_UE4_20, out _);
+
+        var array = Assert.IsType<ArrayProperty>(tag.Tag).Value;
+        var value = Assert.IsType<FStructFallback>(Assert.IsType<StructProperty>(Assert.Single(array.Properties)).Value.StructType);
+        Assert.Equal(5f, value.GetOrDefault<float>("Value"));
+    }
+
+    [Fact]
+    public void MovieSceneFloatValueFromSerializeFloatChannelIsBinary()
+    {
+        var w = new Writer().Tag("Value", "StructProperty", 4 + 2 + 17, t => t.Name("MovieSceneFloatValue").Guid())
+            .Float(5).Byte(0).Byte(0).Float(0).Float(0).Byte(0).Float(0).Float(0);
+        var tag = ReadTag(w.ToArray(), EGame.GAME_UE4_22, out var ar);
+
+        Assert.IsType<FMovieSceneValue<float>>(Assert.IsType<StructProperty>(tag.Tag).Value.StructType);
+        Assert.Equal(w.Length, ar.Position);
+    }
+
+    [Fact]
+    public void TaggedSubSectionRangesMapUsesGuidKeys()
+    {
+        var range = new byte[] { 1, 0, 0, 0, 0, 0, 0x0F, 0xFA, 0x15, 0x00 };
+        var w = new Writer().Tag("SubSectionRanges", "MapProperty", 8 + 16 + range.Length, t => t.Name("StructProperty").Name("StructProperty"))
+            .Int(0).Int(1).Guid().Bytes(range);
+        var tag = ReadTag(w.ToArray(), EGame.GAME_UE4_25, out _);
+
+        var (key, value) = Assert.Single(Assert.IsType<MapProperty>(tag.Tag).Value.Properties);
+        Assert.IsType<FGuid>(Assert.IsType<StructProperty>(key).Value.StructType);
+        Assert.IsType<FMovieSceneFrameRange>(Assert.IsType<StructProperty>(value!).Value.StructType);
+    }
+
+    [Fact]
+    public void TaggedMapTakesStructAndEnumTypesFromOwner()
+    {
+        // TMap<EType, FVector2D> Scales declared on the owner; the UE4 map tag names only ByteProperty and StructProperty
+        var scales = new PropertyType("MapProperty", innerType: new PropertyType("ByteProperty", enumName: "EType"), valueType: new PropertyType("StructProperty", "Vector2D"));
+        var owner = new Struct(null, "OwnerClass", null, new Dictionary<int, PropertyInfo> { [0] = new(0, "Scales", scales) }, 1);
+        var mappings = new TypeMappings(new Dictionary<string, Struct> { ["OwnerClass"] = owner }, new Dictionary<string, Dictionary<long, string>>());
+
+        var w = new Writer().Tag("Scales", "MapProperty", 8 + 8 + 8, t => t.Name("ByteProperty").Name("StructProperty"))
+            .Int(0).Int(1).Name("EType::Second").Float(0.5f).Float(0.25f).Name("None");
+        var ar = Archive(w.ToArray(), EGame.GAME_UE4_26, mappings);
+        var fallback = new FStructFallback(ar, "OwnerClass");
+
+        var (key, value) = Assert.Single(fallback.GetOrDefault<UScriptMap>("Scales").Properties);
+        Assert.Equal("EType::Second", Assert.IsType<EnumProperty>(key).Value.Text);
+        Assert.Equal(0.25f, (float) Assert.IsType<FVector2D>(Assert.IsType<StructProperty>(value!).Value.StructType).Y);
+        Assert.Equal(w.Length, ar.Position);
+    }
+
+    private sealed class SyntheticPackage : IPackage
+    {
+        public string Name { get; set; } = "synthetic";
+        public CUE4Parse.FileProvider.IFileProvider? Provider => null;
+        public string? ArchiveName => null;
+        public TypeMappings? Mappings { get; init; }
+        public FPackageFileSummary Summary => default;
+        public FNameEntrySerialized[] NameMap { get; } = Names.Select(n => new FNameEntrySerialized(n)).ToArray();
+        public int ImportMapLength => 0;
+        public int ExportMapLength => 0;
+        public Lazy<UObject>[] ExportsLazy => [];
+        public bool IsFullyLoaded => true;
+        public bool CanDeserialize => true;
+        public bool HasFlags(EPackageFlags flags) => false;
+        public int GetExportIndex(string name, StringComparison comparisonType = StringComparison.Ordinal) => -1;
+        public ResolvedObject? ResolvePackageIndex(FPackageIndex? index) => null;
+    }
+}
